# site.config
# Datos personales del sitio — todo lo que "engine" (scripts/, templates/, publish.sh,
# style.css) necesita para generar páginas, en un solo lugar.
#
# Formato: KEY="value" (una por línea). Lo leen tanto Bash (publish.sh, vía `source`)
# como Python (scripts/site_config.py), sin depender de librerías externas.

SITE_TITLE="Andy Cuccaro"
SITE_ROLE="2D &amp; 3D Artist"
SITE_URL="https://andycuccaro.info"
SITE_TAGLINE="2D & 3D Artist based in Buenos Aires — portfolio, articles and posts."
COPYRIGHT_YEAR="2026"
DEMO_REEL_EMBED_URL="https://player.vimeo.com/video/328732645"
OG_IMAGE_URL="https://andycuccaro.info/og-image.jpg"
